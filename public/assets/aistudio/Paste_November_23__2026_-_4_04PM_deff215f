  const langName = { en: 'English', rw: 'Kinyarwanda', fr: 'French' };

  function applyI18n() {
    const dict = I18N[state.lang] || I18N.en;
    $$('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (Object.prototype.hasOwnProperty.call(dict, key)) el.textContent = dict[key];
    });
    $$('[data-i18n-ph]').forEach((el) => {
      const key = el.getAttribute('data-i18n-ph');
      if (Object.prototype.hasOwnProperty.call(dict, key)) el.setAttribute('placeholder', dict[key]);
    });
    document.documentElement.lang = state.lang;
  }

  function tr(key) {
    const dict = I18N[state.lang] || I18N.en;
    return Object.prototype.hasOwnProperty.call(dict, key) ? dict[key] : (I18N.en[key] || key);
  }

  /* ================= Toasts ================= */
  function toast(msg, type) {
    const container = $('#toastContainer');
    if (!container) return;
    const t = document.createElement('div');
    t.className = 'toast' + (type ? ' ' + type : '');
    t.textContent = msg;
    container.appendChild(t);
    setTimeout(() => { t.classList.add('out'); setTimeout(() => t.remove(), 350); }, 3200);
  }

  /* ================= View switching ================= */
  const VIEWS = ['dashboard', 'lesson', 'assistant', 'assessment', 'methodology', 'resources', 'settings'];

  function showView(name) {
    if (!VIEWS.includes(name)) name = 'dashboard';
    $$('.view').forEach((v) => v.classList.toggle('active', v.id === 'view-' + name));
    $$('.nav-btn').forEach((b) => b.classList.toggle('active', b.dataset.view === name));
    const ws = $('#workspaceApp');
    if (ws) ws.classList.remove('sidebar-open');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function openWorkspace(viewName) {
    const landing = $('#landingPage');
    const workspace = $('#workspaceApp');
    if (landing) landing.hidden = true;
    if (workspace) { workspace.hidden = false; workspace.style.display = 'flex'; }
    showView(viewName || 'dashboard');
  }

  function goHome() {
    const landing = $('#landingPage');
    const workspace = $('#workspaceApp');
    if (workspace) workspace.hidden = true;
    if (landing) { landing.hidden = false; window.scrollTo({ top: 0, behavior: 'smooth' }); }
  }

  /* ================= Language / Theme ================= */
  function setLang(lang) {
    if (!['en', 'rw', 'fr'].includes(lang)) lang = 'en';
    state.lang = lang;
    ['landingLangSelect', 'langSelect', 'settingsLang'].forEach((id) => {
      const sel = document.getElementById(id);
      if (sel) sel.value = lang;
    });
    applyI18n();
    try { localStorage.setItem('ghad_lang', lang); } catch (_) {}
  }

  function setTheme(theme) {
    if (!['auto', 'light', 'dark'].includes(theme)) theme = 'auto';
    state.theme = theme;
    document.documentElement.setAttribute('data-theme', theme);
    ['themeSelect', 'settingsTheme'].forEach((id) => {
      const sel = document.getElementById(id);
      if (sel) sel.value = theme;
    });
    try { localStorage.setItem('ghad_theme', theme); } catch (_) {}
  }

  safe($('#landingLangSelect'), (el) => el.addEventListener('change', () => setLang(el.value)));
  safe($('#langSelect'), (el) => el.addEventListener('change', () => setLang(el.value)));
  safe($('#settingsLang'), (el) => el.addEventListener('change', () => setLang(el.value)));
  safe($('#themeSelect'), (el) => el.addEventListener('change', () => setTheme(el.value)));
  safe($('#settingsTheme'), (el) => el.addEventListener('change', () => setTheme(el.value)));

  /* ================= Launch / navigation ================= */
  $$('[data-launch]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openWorkspace(el.getAttribute('data-launch'));
    });
  });
  $$('.nav-btn[data-view], .feature-card[data-view]').forEach((el) => {
    el.addEventListener('click', () => showView(el.getAttribute('data-view')));
  });
  safe($('#backToHomeBtn'), (el) => el.addEventListener('click', goHome));
  safe($('#menuToggle'), (el) =>
    el.addEventListener('click', () => {
      const ws = $('#workspaceApp');
      if (ws) ws.classList.toggle('sidebar-open');
    })
  );
  safe($('#footerYear'), (el) => { el.textContent = String(new Date().getFullYear()); });

  /* ================= 3D tilt + parallax orbs ================= */
  if (!window.matchMedia('(hover: none)').matches) {
    $$('[data-tilt]').forEach((card) => {
      const max = 10;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        if (!r.width || !r.height) return;
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform =
          'perspective(900px) rotateY(' + (px * max).toFixed(2) + 'deg) rotateX(' +
          (-py * max).toFixed(2) + 'deg) translateZ(8px)';
      });
      card.addEventListener('pointerleave', () => { card.style.transform = ''; });
    });
    window.addEventListener('pointermove', (e) => {
      const cx = e.clientX / window.innerWidth - 0.5;
      const cy = e.clientY / window.innerHeight - 0.5;
      $$('.orb').forEach((orb, i) => {
        const depth = (i + 1) * 18;
        orb.style.transform = 'translate(' + (-cx * depth).toFixed(1) + 'px,' + (-cy * depth).toFixed(1) + 'px)';
      });
    });
  }

  /* ================= Copy helper ================= */
  function copyText(text, okMsg) {
    const done = () => toast(okMsg || tr('toast_copied'), 'success');
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
    } else fallbackCopy(text, done);
  }
  function fallbackCopy(text, done) {
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); ta.remove(); done();
    } catch (_) { toast(tr('toast_copy_fail'), 'error'); }
  }

  /* ================= API helper ================= */
  async function postJSON(url, payload) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (!res.ok) throw new Error('Server error (' + res.status + ')');
    const data = await res.json();
    if (typeof data === 'string') return data;
    return data.output || data.result || data.text || data.message || data.content ||
      data.lesson || data.assessment || data.methodology || data.reply || data.answer ||
      JSON.stringify(data, null, 2);
  }

  /* ================= Markdown-ish table detection & rendering ================= */
  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function mdTablesToHtml(text) {
    const lines = String(text).split('\n');
    let html = '', i = 0;
    while (i < lines.length) {
      const line = lines[i];
      // detect a markdown table: | a | b | ... followed by | --- | --- |
      if (/^\s*\|.*\|\s*$/.test(line) && i + 1 < lines.length && /^\s*\|[\s:|-]+\|\s*$/.test(lines[i + 1])) {
        const parseRow = (l) => l.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.trim());
        const headers = parseRow(line);
        i += 2;
        const rows = [];
        while (i < lines.length && /^\s*\|.*\|\s*$/.test(lines[i])) {
          rows.push(parseRow(lines[i]));
          i++;
        }
        html += '<table><thead><tr>' +
          headers.map((h) => '<th>' + inlineMd(h) + '</th>').join('') + '</tr></thead><tbody>' +
          rows.map((r) => '<tr>' + r.map((c) => '<td>' + inlineMd(c) + '</td>').join('') + '</tr>').join('') +
          '</tbody></table>';
        continue;
      }
      html += inlineMd(line) + '\n';
      i++;
    }
    return html;
  }

  function inlineMd(s) {
    return esc(s)
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/^### (.*)$/, '<h3 class="cbc-heading">$1</h3>')
      .replace(/^## (.*)$/, '<h3 class="cbc-heading">$1</h3>')
      .replace(/^# (.*)$/, '<h3 class="cbc-heading">$1</h3>');
  }

  /* ================= REB CBC lesson plan renderer ================= */
  function renderCbcLessonPlan(rawText, form) {
    const body = document.getElementById('lessonBody');
    if (!body) return;
    const t = (k) => tr(k);

    const infoRows = [
      [t('cbc_school'), form.school || '____________________'],
      [t('cbc_teacher'), form.teacher || '____________________'],
      [t('cbc_term'), form.term || '______', t('cbc_year'), form.year || '______'],
      [t('cbc_subject'), form.subject, t('cbc_class'), form.klass],
      [t('cbc_unit'), form.unit || '______', t('cbc_lessonno'), '______'],
      [t('cbc_duration'), form.duration + ' min', t('cbc_size'), form.learners],
      [t('cbc_sen'), form.sen || 'None'],
      [t('cbc_date'), form.date || '____ / ____ / ______', t('cbc_period'), '______']
    ];

    const stages = [
      [t('cbc_stage_intro'), form.intro || '', ''],
      [t('cbc_stage_body'), form.body || '', ''],
      [t('cbc_stage_concl'), form.concl || '', '']
    ];

    const aiHtml = mdTablesToHtml(rawText);

    body.innerHTML =
      '<div class="cbc-doc">' +
      '<h3 class="cbc-heading">' + esc(t('cbc_title')) + ': ' + esc(form.topic) + '</h3>' +
      '<table>' + infoRows.map((r) =>
        '<tr>' + r.map((c) => '<td>' + esc(c) + '</td>').join('') + '</tr>').join('') + '</table>' +
      '<h3 class="cbc-heading">' + esc(t('cbc_competence')) + '</h3>' +
      '<p>' + esc(form.competence || '—') + '</p>' +
      '<h3 class="cbc-heading">' + esc(t('cbc_stages')) + '</h3>' +
      '<table class="stages"><thead><tr>' +
      '<th>' + esc(t('cbc_stages')) + '</th>' +
      '<th>' + esc(t('cbc_desc')) + '</th>' +
      '<th>' + esc(t('cbc_generic')) + '</th>' +
      '</tr></thead><tbody>' +
      stages.map((s) =>
        '<tr><td>' + esc(s[0]) + '</td><td>' + (s[1] ? mdTablesToHtml(s[1]) : '—') + '</td><td>' + esc(s[2] || '—') + '</td></tr>'
      ).join('') + '</tbody></table>' +
      '<h3 class="cbc-heading">' + esc(t('cbc_teacher_act')) + ' / ' + esc(t('cbc_learner_act')) + ' (AI)</h3>' +
      aiHtml +
      '</div>';
  }

  /* ================= Output rendering ================= */
  function renderResult(outId, bodyId, copyBtnId, text) {
    const out = document.getElementById(outId);
    const body = document.getElementById(bodyId);
    if (!out || !body) return;
    body.innerHTML = '<pre class="cbc-raw">' + esc(text) + '</pre>';
    out.classList.remove('hidden');
    body.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    const btn = document.getElementById(copyBtnId);
    if (btn) btn.onclick = () => copyText(text, tr('toast_copied'));
    out.dataset.raw = text;
  }

  function setLoading(btn, busy, busyText) {
    if (!btn) return;
    if (busy) {
      btn.dataset.original = btn.textContent;
      btn.textContent = busyText || tr('toast_busy');
      btn.disabled = true;
    } else {
      btn.textContent = btn.dataset.original || 'Generate';
      btn.disabled = false;
    }
  }

  /* ================= Prompt template (REB CBC format) ================= */
  const CBC_PROMPT = [
    'You are an expert Rwandan CBC (Competence-Based Curriculum) teacher-trainer.',
    'Write the response in {LANG}.',
    'Produce a COMPLETE competence-based lesson plan following the official REB / elearning.reb.rw format:',
    '1) Basic information: School name, Teacher names, Term, Year, Subject, Class/Stream, Unit No, Lesson No, Duration, Class size, Type of special educational needs, Date, Period.',
    '2) Key Unit Competence.',
    '3) Title of the lesson.',
    '4) A table with columns: Stages/Timing | Description of teaching and learning activity | Generic competences and cross-cutting issues.',
    '   Stages must include: Introduction (refer back to prior knowledge, link to daily life, introduction of the new lesson),',
    '   Development/Body (presentation of the lesson content with teacher activities AND learner activities, group work, discovery),',
    '   Conclusion/Assessment (summary, formative assessment exercises, marks and remarks).',
    '5) Include specific competences, generic competences, cross-cutting issues, teaching materials and references.',
    'Use markdown tables so the output can be rendered as a table. Be professional, realistic and complete — the teacher will submit this document.'
  ].join('\n');

  /* ================= Lesson generator ================= */
  safe($('#generateLesson'), (btn) => {
    btn.addEventListener('click', async () => {
      const form = {
        subject: val('lessonSubject'), klass: val('lessonClass'), topic: val('lessonTopic'),
        duration: val('lessonDuration') || '40', unit: val('lessonUnit'),
        learners: val('lessonLearners') || '40', extra: val('lessonExtra'),
        school: '', teacher: '', term: '', year: '', date: '', sen: '', competence: ''
      };
      if (!form.subject || !form.klass || !form.topic) {
        toast(tr('toast_fill'), 'error');
        return;
      }
      setLoading(btn, true);
      try {
        const payload = {
          language: state.lang, langName: langName[state.lang],
          subject: form.subject, class: form.klass, topic: form.topic,
          duration: form.duration, unit: form.unit, learners: form.learners, extra: form.extra,
          prompt: CBC_PROMPT.replace('{LANG}', langName[state.lang]) +
            '\nSubject: ' + form.subject + '\nClass: ' + form.klass + '\nTopic: ' + form.topic +
            '\nUnit: ' + (form.unit || 'N/A') + '\nDuration: ' + form.duration + ' minutes' +
            '\nNumber of learners: ' + form.learners +
            (form.extra ? '\nExtra instructions: ' + form.extra : '')
        };
        const text = await postJSON('/api/lesson', payload);
        renderCbcLessonPlan(text, form);
        const out = document.getElementById('lessonOutput');
        if (out) out.dataset.raw = text;
        document.getElementById('lessonOutput').classList.remove('hidden');
        toast(tr('toast_lesson'), 'success');
      } catch (err) {
        toast((tr('toast_net')) + (err && err.message ? ' — ' + err.message : ''), 'error');
      } finally {
        setLoading(btn, false);
      }
    });
  });

  /* ================= Print / PDF for lesson ================= */
  safe($('#printLesson'), (btn) => {
    btn.addEventListener('click', () => window.print());
  });

  /* ================= Chat assistant ================= */
  function addChatMsg(role, text) {
    const box = $('#chatMessages');
    if (!box) return null;
    const div = document.createElement('div');
    div.className = 'chat-msg ' + (role === 'user' ? 'user' : 'bot');
    div.textContent = text;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
    return div;
  }

  async function sendChat() {
    const input = $('#chatInput');
    const btn = $('#sendChat');
    if (!input) return;
    const text = (input.value || '').trim();
    if (!text) return;
    addChatMsg('user', text);
    input.value = '';
    const thinking = addChatMsg('bot', '…');
    if (btn) btn.disabled = true;
    try {
      const reply = await postJSON('/api/assistant', {
        language: state.lang, langName: langName[state.lang], message: text
      });
      if (thinking && thinking.parentNode) thinking.remove();
      addChatMsg('bot', reply);
    } catch (_) {
      if (thinking && thinking.parentNode) thinking.remove();
      addChatMsg('bot', '⚠️ ' + tr('toast_net'));
    } finally {
      if (btn) btn.disabled = false;
      input.focus();
    }
  }

  safe($('#sendChat'), (btn) => btn.addEventListener('click', sendChat));
  safe($('#chatInput'), (input) =>
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendChat(); }
    })
  );

  /* ================= Assessment generator ================= */
